{
  "name": "leave-it-to-bum-bum",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postbuild": "node -e \"const fs=require('fs');if(fs.existsSync('out/tools.html')){fs.mkdirSync('out/tools',{recursive:true});fs.copyFileSync('out/tools.html','out/tools/index.html');console.log('postbuild: tools/index.html ready')}\""
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "18.5.0"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2"
  }
}
