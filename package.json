{
  "name": "leave-it-to-bum-bum",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "postbuild": "node -e \"const fs=require('fs');for(const p of ['tools','pricing','36-hours']){const f='out/'+p+'.html';if(fs.existsSync(f)){fs.mkdirSync('out/'+p,{recursive:true});fs.copyFileSync(f,'out/'+p+'/index.html');console.log('postbuild: '+p+'/index.html ready')}}\""
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "18.5.0"
  },
  "devDependencies": {
    "@types/node": "24.3.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "5.9.2"
  }
}
